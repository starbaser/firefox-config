{
  "manifest_version": 2,
  "name": "Account Switcher — Claude & ChatGPT",
  "version": "1.0.0",
  "description": "Save and switch between multiple claude.ai and chatgpt.com sessions, with live plan and usage-limit meters.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://openai.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    },
    "default_title": "Account Switcher"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "account-switcher@eigenmage.com",
      "strict_min_version": "109.0"
    }
  }
}
